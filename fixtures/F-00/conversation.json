            "role": "assistant"
          },
          "content": {
            "content_type": "text",
            "parts": [
              "Start with power and the clock: check the battery, then confirm the timer's date and program are still set."
            ]
          },
          "create_time": 1800000020,
          "id": "msg-f-00-a-2",
          "metadata": {
            "model_slug": "synthetic-model"
