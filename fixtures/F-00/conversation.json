          "msg-f-00-u-23"
        ],
        "id": "msg-f-00-a-22",
        "message": {
          "author": {
            "role": "assistant"
          },
          "content": {
            "content_type": "text",
            "parts": [
              "So the map shows the paths and people keep the choice. The routing is observed, not imposed."
            ]
          },
          "create_time": 1800000220,
          "id": "msg-f-00-a-22",
          "metadata": {
            "model_slug": "synthetic-model"
          }
        },
        "parent": "msg-f-00-u-21"
      },
